{
  "name": "tiktok-motion-engine",
  "private": true,
  "version": "1.0.0",
  "description": "Moteur de motion design piloté par storyboard.json, rendu Canvas 2D déterministe et export WebM 1080×1920 depuis le navigateur.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "examples": "node --experimental-strip-types --no-warnings scripts/build-examples.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
